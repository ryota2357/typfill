{
  "name": "typfill",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "biome format --write './'",
    "check": "biome check './'",
    "check:write": "biome check --write './'",
    "test:unit": "vitest",
    "test": "pnpm run test:unit -- --run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.64.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-svelte-plugin": "0.3.52",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vitest-browser-svelte": "3.1.0",
    "wrangler": "4.157.0"
  },
  "dependencies": {
    "@core/unknownutil": "jsr:4.4.0-pre.1",
    "@lucide/svelte": "1.64.0",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "lz-string": "1.5.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
